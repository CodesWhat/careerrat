{
  "name": "@careerrat/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "dev": "next dev --port 3002",
    "build:docs-content": "node ../../scripts/build-docs-content.mjs",
    "prebuild": "npm run build:docs-content",
    "build": "next build && node ../../scripts/harden-static-html.mjs out --allow-posthog-proxy",
    "start": "next start"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "posthog-js": "1.429.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2"
  }
}
