{
  "name": "careerrat",
  "version": "0.9.0",
  "private": false,
  "packageManager": "npm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Agentic job-search workspace for finding, vetting, tailoring, tracking, and preparing for roles.",
  "author": "CodesWhat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodesWhat/careerrat.git"
  },
  "homepage": "https://github.com/CodesWhat/careerrat#readme",
  "bugs": {
    "url": "https://github.com/CodesWhat/careerrat/issues"
  },
  "bin": {
    "careerrat": "bin/careerrat.mjs"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "config/*.schema.json",
    "config/*.example.*",
    "config/paste-intake-routes.json",
    "templates",
    ".agents/skills/answer-question/SKILL.md",
    ".agents/skills/apply-job/SKILL.md",
    ".agents/skills/calendar-sync/SKILL.md",
    ".agents/skills/company-health/SKILL.md",
    ".agents/skills/configure/SKILL.md",
    ".agents/skills/discover-companies/SKILL.md",
    ".agents/skills/email-comms/SKILL.md",
    ".agents/skills/evaluate-job/SKILL.md",
    ".agents/skills/ingest-mail/SKILL.md",
    ".agents/skills/ingest-messages/SKILL.md",
    ".agents/skills/ingest-profile/SKILL.md",
    ".agents/skills/intake-extract/SKILL.md",
    ".agents/skills/interview-prep/SKILL.md",
    ".agents/skills/optimize-linkedin/SKILL.md",
    ".agents/skills/reevaluate-strategy/SKILL.md",
    ".agents/skills/relationship-sourcing/SKILL.md",
    ".agents/skills/report-issue/SKILL.md",
    ".agents/skills/research-boards/SKILL.md",
    ".agents/skills/research-comp/SKILL.md",
    ".agents/skills/research-company/SKILL.md",
    ".agents/skills/resume-extract/SKILL.md",
    ".agents/skills/schedule-meeting/SKILL.md",
    ".agents/skills/search-jobs/SKILL.md",
    ".agents/skills/setup-searches/SKILL.md",
    ".agents/skills/sync-status/SKILL.md",
    ".agents/skills/tailor-application/SKILL.md",
    ".agents/skills/track-outcomes/SKILL.md",
    "docs/ARCHITECTURE.md",
    "docs/BROWSER.md",
    "docs/DISCLAIMER.md",
    "docs/RELEASE.md",
    "docs/ROADMAP.md",
    "docs/SETUP.md",
    "docs/SOURCES.md",
    "docs/foundations-spec.md",
    "examples",
    "assets",
    "apps/web/dist",
    "scripts/analyze-outcomes.mjs",
    "scripts/calibrate-writing-style.mjs",
    "scripts/capture-board-snapshot.mjs",
    "scripts/capture-search-sources.mjs",
    "scripts/check-job-links.mjs",
    "scripts/delta-sourced.mjs",
    "scripts/install-skills.mjs",
    "scripts/scan-sourced.mjs",
    "scripts/verify-tracker.mjs",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/DATA_CONTRACT.md",
    "README.md"
  ],
  "scripts": {
    "hooks:install": "lefthook install",
    "prepack": "npm run build --workspace apps/web",
    "dev": "turbo dev",
    "build": "turbo build --filter=!@careerrat/docs",
    "site:dev": "npm --workspace @careerrat/website run dev",
    "site:build": "npm --workspace @careerrat/website run build",
    "docs:dev": "npm --workspace @careerrat/docs run dev",
    "docs:build": "npm --workspace @careerrat/docs run build",
    "app:dev": "npm run dev --workspace apps/web",
    "app:build": "npm run build --workspace apps/web",
    "desktop": "npm --workspace apps/desktop run dev",
    "desktop:fresh": "CAREERRAT_HOME=.careerrat-fresh npm run desktop",
    "desktop:dist": "npm --workspace apps/desktop run dist",
    "desktop:release": "npm --workspace apps/desktop run release",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "format": "biome format --write .",
    "install-skills": "node scripts/install-skills.mjs",
    "install-skills:check": "node scripts/install-skills.mjs --check",
    "doctor": "node src/cli/doctor.mjs",
    "doctor:json": "node src/cli/doctor.mjs --json",
    "next": "node src/cli/next.mjs",
    "ingest": "node src/cli/ingest.mjs",
    "searches": "node src/cli/searches.mjs",
    "companies": "node src/cli/companies.mjs",
    "evaluate": "node src/cli/evaluate.mjs",
    "questions": "node src/cli/questions.mjs",
    "tracker": "node src/cli/tracker.mjs",
    "tracker:dev": "node src/cli/tracker-dev.mjs",
    "serve": "node src/cli/tracker-dev.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "deploy:demo": "node scripts/deploy-demo.mjs",
    "gate": "node src/cli/gate.mjs",
    "learnings": "node src/cli/learnings.mjs",
    "activity": "node src/cli/activity.mjs",
    "research": "node src/cli/research.mjs",
    "stories": "node src/cli/stories.mjs",
    "strategy-review": "node src/cli/strategy-review.mjs",
    "analytics": "node src/cli/analytics.mjs",
    "evidence": "node src/cli/evidence.mjs",
    "modes": "node src/cli/modes.mjs",
    "automation": "node src/cli/automation.mjs",
    "status:map": "node src/cli/status-map.mjs",
    "export": "node src/cli/export.mjs",
    "lint:placeholders": "node src/cli/lint-placeholders.mjs",
    "test": "node --test 'tests/**/*.test.mjs'",
    "scan:sourced": "node scripts/scan-sourced.mjs",
    "delta:sourced": "node scripts/delta-sourced.mjs",
    "capture:board": "node scripts/capture-board-snapshot.mjs",
    "capture:search-sources": "node scripts/capture-search-sources.mjs",
    "check:jobs": "node scripts/check-job-links.mjs",
    "verify:tracker": "node scripts/verify-tracker.mjs",
    "analyze:outcomes": "node scripts/analyze-outcomes.mjs",
    "calibrate:style": "node scripts/calibrate-writing-style.mjs",
    "ai-proxy": "node src/cli/ai-proxy.mjs"
  },
  "keywords": [
    "job-search",
    "career",
    "resume",
    "agentic",
    "codex",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "@biomejs/biome": "2.5.8",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "playwright": "1.62.1",
    "turbo": "2.10.10"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.0": true,
    "lefthook@2.1.10": true
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.12.0",
    "sanitize-html": "^2.17.4",
    "undici": "^7.28.0"
  }
}
