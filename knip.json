{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pandoc", "soffice", "iconutil"],
  "workspaces": {
    ".": {
      "entry": ["src/cli/*.mjs", "scripts/*.mjs", "scripts/eval/*.mjs", "plugins/*/index.mjs"],
      "project": [
        "src/**/*.mjs",
        "scripts/**/*.mjs",
        "bin/**/*.mjs",
        "tests/**/*.mjs",
        "plugins/**/*.mjs"
      ],
      "ignore": [
        "src/core/providers/career-ops/vendor/**",
        "tests/fixtures/career-ops/**",
        "tests/fixtures/db-concurrency-worker.mjs"
      ]
    },
    "apps/web": {},
    "apps/docs": {
      "ignoreDependencies": [
        "@fontsource/archivo",
        "@fontsource/ibm-plex-mono",
        "@fontsource/ibm-plex-sans"
      ]
    },
    "apps/desktop": {
      "entry": ["scripts/*.mjs", "preload/*.cjs"]
    },
    "apps/website": {
      "ignoreDependencies": ["@fontsource/figtree"]
    }
  }
}
