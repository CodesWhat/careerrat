{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mkfifo"],
  "workspaces": {
    ".": {
      "entry": [
        "src/cli/*.mjs",
        "scripts/*.mjs",
        "scripts/eval/*.mjs",
        "plugins/*/index.mjs",
        "src/core/ai/runtime-probe-helper.mjs",
        "src/core/tui/textual-bridge.mjs"
      ],
      "project": [
        "src/**/*.mjs",
        "scripts/**/*.mjs",
        "bin/**/*.mjs",
        "tests/**/*.mjs",
        "plugins/**/*.mjs"
      ],
      "ignore": [
        "src/core/providers/career-ops/vendor/**",
        "src/core/providers/career-ops/lib/**",
        "tests/fixtures/career-ops/**",
        "tests/fixtures/db-concurrency-worker.mjs"
      ]
    },
    "apps/web": {},
    "apps/docs": {
      "ignoreDependencies": [
        "@fontsource/archivo",
        "@fontsource/ibm-plex-mono",
        "@fontsource/ibm-plex-sans"
      ]
    },
    "apps/website": {
      "ignoreDependencies": ["@fontsource/figtree"]
    }
  }
}
