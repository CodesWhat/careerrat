{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pandoc", "soffice", "iconutil"],
  "workspaces": {
    ".": {
      "entry": ["src/cli/*.mjs", "scripts/*.mjs"],
      "project": ["src/**/*.mjs", "scripts/**/*.mjs", "bin/**/*.mjs", "tests/**/*.mjs"],
      "ignore": [
        "src/core/providers/career-ops/vendor/**",
        "tests/fixtures/career-ops/**",
        "tests/fixtures/db-concurrency-worker.mjs"
      ]
    },
    "apps/web": {
      "ignore": ["public/theme-init.js"]
    },
    "apps/desktop": {
      "entry": ["scripts/*.mjs", "preload/*.cjs"]
    }
  }
}
