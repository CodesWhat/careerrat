{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PROGRAMFILES",
    "PROGRAMFILES(X86)",
    "BOARD_BROWSER",
    "CAREERRAT_DEMO_KEEP_SCRATCH",
    "CAREERRAT_DEMO_WEB_PORT",
    "CAREERRAT_DEV_PORT",
    "CAREERRAT_LIVE_BROWSER",
    "CAREERRAT_NO_UPDATE_CHECK",
    "CAREERRAT_TRACKER_HOST",
    "PATHEXT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    }
  }
}
