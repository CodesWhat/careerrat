{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerrat.local/schemas/automation.schema.json",
  "title": "CareerRat Browser-Automation Config",
  "description": "Browser-automation switches. Every capability is on by default; set a capability or platform to false to turn it off.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer" },
    "capabilities_default": {
      "description": "Marker written once the config follows the on-by-default contract. Without it, stored capability values are treated as the old off default and every capability reads as on.",
      "enum": ["on"]
    },
    "setup_mode": {
      "description": "Deprecated and ignored. Setup modes were retired; capabilities are on unless turned off. Kept so older files still validate.",
      "enum": ["basic", "advanced"]
    },
    "submit": {
      "description": "auto lets the agent press the final Submit once the form is complete and verifies the confirmation page. manual stops before Submit for a person to press. Absent means auto.",
      "enum": ["auto", "manual"],
      "default": "auto"
    },
    "consent": {
      "description": "Deprecated and ignored. The per-platform consent ledger was retired. Kept so older files still validate.",
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status_polling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "messaging": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "authenticated_apply_preparation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "profile_optimize": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "profile_apply": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "mail_access": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "relationship_sourcing": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "calendar_sync": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        },
        "calendar_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "platforms": { "type": "object", "additionalProperties": { "type": "boolean" } }
          }
        }
      }
    },
    "session": {
      "description": "Tool-agnostic session-browser provider preference. See docs/BROWSER.md.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": { "enum": ["auto", "extension", "orca", "playwright"], "default": "auto" },
        "profile_root": { "type": ["string", "null"] }
      }
    }
  }
}
