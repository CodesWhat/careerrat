{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerrat.local/schemas/search-sources.schema.json",
  "title": "CareerRat Search Sources",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title_filter": {
      "type": "object",
      "additionalProperties": true
    },
    "location_filter": {
      "type": "object",
      "additionalProperties": true
    },
    "searches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["provider", "label", "enabled"],
        "properties": {
          "provider": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["url-query", "rss", "ats", "aggregator", "browser", "board"]
          },
          "auth": {
            "type": "boolean",
            "description": "True = this source may need a logged-in session. When the session is logged out, ask one site-specific Yes/No question at the point of use."
          },
          "platform": {
            "type": "string",
            "description": "For browser sources, the site whose saved session should be used (linkedin | indeed | wellfound | glassdoor)."
          },
          "label": { "type": "string" },
          "query": { "type": "string" },
          "url": { "type": "string" },
          "rssUrl": { "type": "string" },
          "enabled": { "type": "boolean" },
          "login_skipped": {
            "type": "boolean",
            "description": "True after the user answers No to the point-of-use login question. A later explicit enable clears it."
          },
          "lastRunAt": { "type": "string" },
          "recency": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["since-last-run", "fixed-hours", "manual"]
              },
              "hours": { "type": "number" },
              "windowHours": { "type": "number" },
              "safetyMinutes": { "type": "number" },
              "lastRunAt": { "type": "string" }
            }
          },
          "searchState": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "anyOf": [
          { "required": ["query"] },
          { "required": ["url"] },
          { "required": ["rssUrl"] }
        ]
      }
    },
    "tracked_companies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_catalog": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "required": ["searches"]
}
