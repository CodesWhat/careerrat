{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerrat.local/schemas/form-defaults.schema.json",
  "title": "CareerRat Form Defaults",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string" },
    "option_aliases": {
      "description": "Candidate-configured alternate dropdown values, keyed by canonical application field.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "work_authorization": { "type": "string" },
    "requires_sponsorship": { "type": "string" },
    "current_employer": { "type": ["string", "null"] },
    "current_title": { "type": ["string", "null"] },
    "expected_base": { "type": ["number", "string", "null"], "minimum": 0 },
    "linkedin": { "type": ["string", "null"] },
    "github": { "type": ["string", "null"] },
    "portfolio": { "type": ["string", "null"] },
    "eeo_default": {
      "description": "Deprecated compatibility field. It is never consumed as self-identification consent.",
      "type": "string",
      "deprecated": true
    },
    "voluntary_self_identification": {
      "description": "Explicit candidate-controlled defaults for voluntary demographic questions. Disabled by default.",
      "type": "object",
      "required": ["enabled", "default_action", "confirmed_at", "answers"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "confirmed_at": { "type": "string", "minLength": 1, "format": "date-time" }
            }
          }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "default_action": {
          "type": "string",
          "enum": ["leave_blank", "decline_when_available"]
        },
        "confirmed_at": { "type": ["string", "null"], "minLength": 1, "format": "date-time" },
        "answers": {
          "description": "Exact normalized question text mapped to a candidate-confirmed answer.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$" },
          "additionalProperties": {
            "type": "object",
            "required": ["value", "confirmed_at"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "confirmed_at": { "type": "string", "minLength": 1, "format": "date-time" }
            }
          }
        }
      }
    },
    "screening_answers": {
      "description": "Pre-reviewed answers for recurring custom application questions. Keys are normalized question text; values are the exact answer to fill.",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "document_formats": {
      "description": "Packet export preferences for generated application artifacts.",
      "type": "object",
      "required": ["default_packet_format", "required_export_formats"],
      "additionalProperties": false,
      "properties": {
        "default_packet_format": {
          "type": "string",
          "enum": ["pdf", "docx"],
          "default": "pdf"
        },
        "required_export_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pdf", "docx"]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "confirm_current_role": { "type": "boolean" },
    "confirm_current_disclosure": { "type": "boolean" },
    "declined_fields": {
      "description": "Fields the candidate explicitly declined to answer during the conversational interview (e.g. \"authorization\", \"consent\") — never re-asked once recorded here. A null value clears a decline (manual override reopens the normal editor).",
      "type": "object",
      "additionalProperties": {
        "type": ["object", "null"],
        "required": ["declined_at"],
        "additionalProperties": false,
        "properties": {
          "declined_at": { "type": "string" }
        }
      }
    }
  }
}
