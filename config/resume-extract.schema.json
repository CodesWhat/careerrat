{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolester.local/schemas/resume-extract.schema.json",
  "title": "Rolester resume-extract skill output",
  "type": "object",
  "required": [
    "full_text",
    "candidate",
    "claims",
    "sections",
    "targeting_suggestions"
  ],
  "additionalProperties": false,
  "properties": {
    "full_text": {
      "type": "string"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "linkedin": { "type": ["string", "null"] },
        "github": { "type": ["string", "null"] },
        "portfolio": { "type": ["string", "null"] }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "object",
      "required": ["experience", "education", "skills", "projects", "other"],
      "additionalProperties": false,
      "properties": {
        "experience": { "type": "integer" },
        "education": { "type": "integer" },
        "skills": { "type": "integer" },
        "projects": { "type": "integer" },
        "other": { "type": "integer" }
      }
    },
    "targeting_suggestions": {
      "type": "object",
      "required": ["role_buckets", "keep_signals", "tracked_companies"],
      "additionalProperties": false,
      "properties": {
        "role_buckets": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "priority", "titles"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "priority": {
                "type": "string",
                "enum": ["primary", "secondary", "stretch", "oe", "adjacent"]
              },
              "titles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string" }
              },
              "notes": { "type": ["string", "null"] },
              "fit_signals": {
                "type": "array",
                "maxItems": 12,
                "items": { "type": "string" }
              },
              "down_signals": {
                "type": "array",
                "maxItems": 12,
                "items": { "type": "string" }
              }
            }
          }
        },
        "keep_signals": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string" }
        },
        "tracked_companies": {
          "type": "array",
          "maxItems": 24,
          "items": { "type": "string" }
        }
      }
    }
  }
}
