node_modules/
.env
.env.local

# Local throwaway demo workspace seeded by scripts/demo-serve.sh
# (CAREERRAT_HOME=./.demo-home) — never real data, never checked in.
.demo-home/

# Scratch video/screenshot working dir for scripts/capture-chat-demo.mjs —
# removed by the script itself on both success and failure; ignored here as a
# backstop in case a run is interrupted before cleanup.
.demo-capture/

# Turborepo build artifacts. Each app owns its local Next/Vite output rules.
.turbo/

# qlty config (track qlty.toml, ignore the CLI's local cache/output symlinks)
.qlty/*
!.qlty/qlty.toml

# apps/web build artifacts (M7 SPA shell) — built fresh, shipped via
# package.json#files["apps/web/dist"], same "gitignored generated release
# artifact" pattern as the Next app outputs above.
apps/web/dist/

# apps/desktop build artifacts. staging/ (scripts/stage.mjs's extraResources
# tree) needs an explicit ignore; apps/desktop/dist/ and apps/desktop/
# node_modules/ are already covered by the bare `dist/` and `node_modules/`
# patterns above (no path prefix = match at any depth).
apps/desktop/staging/

# build:demo static bundle (rebuilt per deploy so dates stay evergreen)
dist/
*.tsbuildinfo
.vercel/

# macOS
.DS_Store

# Python (build-docx.py)
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / temp
*.swp
*~

# Playwright MCP scratch (browser artifacts, snapshots)
.playwright-mcp/

# Agent worktrees / local agent state
.claude/

# Browser-automation / Playwright / verification screenshots are SCRATCH by
# default. They belong under workspace/captures/ (ignored below) and must never
# be committed to the repo root or workspace root. Backstop-ignore stray PNGs in
# those two spots so apply/automation captures never clutter the tree — real
# image assets live in assets/, apps/website/public/, and app-specific trees. The tracked
# mascot is the one root-PNG exception. Surface a capture in the app only by
# writing it to a deliberately tracked path.
/*.png
!/careerrat-rat.png
workspace/*.png
tracker-*.png

# Local QA evidence bundles (screenshots/logs, 100MB+) — the prose findings get
# tracked via the roadmap, the raw evidence stays local.
/qa/

# Design handoff archives dropped at repo root — extracted where needed, never committed.
/*.zip

# Private working roadmap + internal planning docs (names the private origin,
# competitor analysis, and personal context). The PUBLIC roadmap is docs/ROADMAP.md.
# Anchor to root with a leading slash — a bare "ROADMAP.md" also ignores the public
# docs/ROADMAP.md (matches in every directory), which must stay tracked.
/ROADMAP.md
# The whole planning tree is local. It was tracked until 2026-08-27, which put
# competitor intel and product plans in a public repo. Anything under here that
# CI needs has been moved out to docs/ instead: contracts belong somewhere the
# tests can read them on a fresh clone, and nothing untracked survives one.
.planning/
/ROADMAP-ARCHIVE.md
/CLI-PARITY-EXEC-SUMMARY.html
/RUNTIME-PARITY-PLAN.md
/CODE-REVIEW-FINDINGS.md
docs/COMPARISON.md
# CLI-owned runtime state: ai.env (chmod 0600, loaded at server boot), the
# tracker-dev pid/log, and update caches. Not documents — the review write-ups
# that used to live here moved to .planning/review/ on 2026-08-27. This is one
# of four legacy roots (candidate/, workspace/, config/, .internal/) that
# src/core/paths/workspace.mjs is folding into .careerrat/; don't add a fifth.
.internal/

# Consolidated local user data root (candidate/workspace/generated config/internal).
.careerrat/

# Alternate CAREERRAT_HOME used by `npm run desktop:fresh` to boot the desktop
# app against a clean data root (fresh onboarding / fresh-db smoke tests)
# without touching the real .careerrat/ data root.
#
# Match ANY *-fresh data root, not just the current product name. A stale
# pre-rename data root was once left unignored and a later `git add -A`
# committed a real candidate profile. A name-specific pattern is one rename
# away from repeating that failure.
.careerrat-fresh/
*-fresh/

# Local candidate data
/candidate/

# Personal one-off migration/ingest scripts — they hardcode the candidate's own
# pipeline (specific JD paths, role vocabulary), identity, or the private origin,
# so they must never ship. Kept local for re-runs/record; the generic, neutral
# migration helpers in scripts/ stay tracked.
scripts/migration-enrichment.workflow.mjs
scripts/repo-ingest.workflow.mjs
scripts/draft-*-stories.mjs

# Generated/personal search + scan config (schema + *.example.* stay committed).
# These hold the candidate's role keywords, geography, and company watchlist — they
# must never ship as defaults (no-config = domain-neutral). See *.example counterparts.
config/search-sources.yml
config/search-sources.json
config/sourced-scan.json

# User-local model-swap config (schema + example stay committed, see
# config/ai.schema.json / config/ai.example.json). Holds an operator's chosen
# model id(s) — no-code-change model swap must never ship a default choice.
config/ai.json

# Generated/private workspace data
workspace/jobs/*
workspace/tailored/*
workspace/intake/*
workspace/scan-results/*
workspace/comms/*
workspace/interview-prep/*
workspace/writing-samples/*
workspace/research/*
workspace/network-leads/*
workspace/captures/*
workspace/logos/*
workspace/legacy/*
workspace/tracker.*
workspace/.snapshots/
workspace/activity.jsonl
workspace/activity.jsonl.bak
workspace/usage-events.jsonl
workspace/usage-events.jsonl.bak
workspace/dashboard-data.js
workspace/modes.json
workspace/settings.json
workspace/library.json
workspace/setup-state.json

!workspace/jobs/.gitkeep
!workspace/tailored/.gitkeep
!workspace/intake/.gitkeep
!workspace/scan-results/.gitkeep
!workspace/comms/.gitkeep
!workspace/interview-prep/.gitkeep
!workspace/writing-samples/.gitkeep
!workspace/research/.gitkeep
!workspace/network-leads/.gitkeep
!workspace/captures/.gitkeep
!workspace/logos/.gitkeep
!workspace/legacy/.gitkeep
.vercel
.env*
