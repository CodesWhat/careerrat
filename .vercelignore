# Keep Vercel uploads to just what the website build needs. Mirrors the
# generated/private trees already ignored in .gitignore so a monorepo deploy
# doesn't waste bandwidth on build output, node_modules, or candidate data.
#
# NOTE: this file uses .gitignore semantics — a pattern with no leading slash
# matches at EVERY depth. A bare `src` here also matched `website/src` and
# `docs-site/src`, so the git-integration build deleted both Next apps' source
# and shipped a 404-only site. Every product-internal path below is anchored
# with a leading slash for that reason. Don't un-anchor them.

# Generated / installed trees — intentionally recursive.
node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
out
**/out
**/*.tsbuildinfo

# CLI / product internals, root only — the Vercel build needs website/ and
# docs-site/ (the latter is built by website's `prebuild` into public/docs).
/candidate
/workspace
/.internal
/.careerrat
/.rolester
/.playwright-mcp
/.agents
/.claude
/bin
# src/ is excluded except the one module harden-static-html.mjs imports.
# gitignore semantics: a re-include only works if no parent DIR is excluded,
# hence the /*-then-! cascade at each level.
/src/*
!/src/core
/src/core/*
!/src/core/security
/src/core/security/*
!/src/core/security/browser-policy.mjs
/config
/templates
# scripts/ is excluded by contents (not the dir itself) so the one build-time
# dependency can be re-included — website/ and docs-site/ both run
# ../scripts/harden-static-html.mjs in their postbuild.
/scripts/*
!/scripts/harden-static-html.mjs
/mockups
/examples
/tests
/docs/COMPARISON.md
/ROADMAP.md
/ROADMAP-ARCHIVE.md

# Heavy local-only trees that broke the 100MB upload limit (2026-08-09).
/qa
/db
/apps/desktop/dist
/apps/desktop/staging
/*.zip
